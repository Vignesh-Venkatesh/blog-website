---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeScreenBanner from "../../components/HomeScreenBanner.astro";
import PostList from "../../components/PostList.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);
    const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
    return tags.map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag!;
const posts = (await getCollection("blog"))
    .filter(({ data }) => !data.draft && data.tags.includes(tag))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`#${tag} | Vignesh Venkatesh`}>
    <main class="category-page" aria-label={`Posts tagged ${tag}`}>
        <HomeScreenBanner title={`#${tag}`} artworkSrc="/images/banners/tags.webp" monochromeArtwork showLinks={false} />
        <PostList posts={posts} showHeading={false} flushTop />
    </main>
</BaseLayout>
