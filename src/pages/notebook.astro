---
import { getCollection } from "astro:content";
import readingTime from "reading-time";

import BaseLayout from "../layouts/BaseLayout.astro";
import TagList from "../components/TagList.astro";

const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft && post.data.category === "notebook")
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postsByYear = Map.groupBy(posts, (post) => post.data.date.getFullYear());

const formatDate = (date: Date) =>
    date
        .toLocaleDateString("en-US", {
            month: "short",
            day: "2-digit",
            year: "numeric",
        })
        .toUpperCase();

// most used notebook tags for the header
const tagCounts = new Map<string, number>();

for (const post of posts) {
    for (const tag of post.data.tags) {
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    }
}

const topTags = [...tagCounts.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([tag]) => tag);
---

<BaseLayout title="Notebook | Vignesh Venkatesh">
    <main class="mx-auto w-full max-w-175 px-6 py-10 sm:py-12">
        <!-- heading -->
        <header class="mb-12">
            <div class="page-reveal page-delay-1 mb-3 font-mono text-[10px] tracking-[0.12em] text-accent sm:text-[11px]">
                notebook
            </div>

            <h1 class="page-reveal page-delay-2 max-w-xl font-serif text-[1.75rem] font-medium leading-[1.1] tracking-tight text-foreground sm:text-[2rem]">
                Thoughts and observations.
            </h1>

            {topTags.length > 0 && (
                <div class="page-reveal page-delay-3 mt-4 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[9px] text-faint sm:text-[10px]">
                    {topTags.map((tag, index) => (
                        <>
                            <a
                                href={`/tags/${tag}`}
                                class="transition-colors duration-150 hover:text-accent"
                            >
                                {tag}
                            </a>

                            {index < topTags.length - 1 && <span>·</span>}
                        </>
                    ))}
                </div>
            )}
        </header>

        <!-- posts -->
        {posts.length > 0 ? (
            <div class="space-y-8">
                {[...postsByYear.entries()].map(([year, yearPosts], index) => (
                    <section
                        class="page-reveal"
                        style={`animation-delay: ${440 + Math.min(index, 3) * 90}ms`}
                    >
                        <!-- year -->
                        <div class="border-b border-border pb-2 font-mono text-[10px] text-faint sm:text-[11px]">
                            {year}
                        </div>

                        <!-- entries -->
                        <div>
                            {yearPosts.map((post) => {
                                const href = `/blog/${post.id}`;
                                const stats = readingTime(post.body ?? "");

                                return (
                                    <article class="border-b border-border py-3">
                                        <!-- metadata -->
                                        <div class="mb-2 flex flex-wrap items-center gap-2 font-mono text-[9px] text-faint sm:text-[10px]">
                                            {post.data.format && (
                                                <>
                                                    <span>
                                                        {post.data.format}
                                                    </span>
                                                    <span>·</span>
                                                </>
                                            )}

                                            <time
                                                datetime={post.data.date.toISOString()}
                                            >
                                                {formatDate(post.data.date)}
                                            </time>

                                            <span>·</span>

                                            <span>{stats.text}</span>
                                        </div>

                                        <!-- title -->
                                        <h2 class="font-serif text-[1.375rem] font-medium leading-[1.15] tracking-tight sm:text-2xl">
                                            <a
                                                href={href}
                                                class="text-foreground transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
                                            >
                                                {post.data.title}
                                            </a>
                                        </h2>

                                        <!-- excerpt -->
                                        <p class="mt-1.5 max-w-2xl font-serif text-[0.9375rem] italic leading-[1.5] text-muted sm:text-base">
                                            {post.data.description}
                                        </p>

                                        <!-- footer -->
                                        <div class="mt-2.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
                                            <TagList tags={post.data.tags} />

                                            <a
                                                href={href}
                                                class="font-mono text-[10px] text-faint transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent sm:text-[11px]"
                                            >
                                                read →
                                            </a>
                                        </div>
                                    </article>
                                );
                            })}
                        </div>
                    </section>
                ))}
            </div>
        ) : (
            <p class="page-reveal page-delay-4 font-mono text-[10px] text-faint sm:text-[11px]">
                No notebook posts yet.
            </p>
        )}
    </main>
</BaseLayout>
