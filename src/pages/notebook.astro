---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeScreenBanner from "../components/HomeScreenBanner.astro";
import PostList from "../components/PostList.astro";

const posts = (await getCollection("blog"))
    .filter(({ data }) => !data.draft && data.category === "notebook")
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Notebook | Vignesh Venkatesh">
    <main class="category-page" aria-label="Notebook posts">
        <HomeScreenBanner title="Thoughts and observations." artworkSrc="/images/banners/notebook.webp" monochromeArtwork showLinks={false} />
        <PostList posts={posts} showHeading={false} flushTop />
    </main>
</BaseLayout>
