---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeScreenBanner from "../components/HomeScreenBanner.astro";
import PostList from "../components/PostList.astro";

const posts = (await getCollection("blog"))
    .filter(({ data }) => !data.draft && data.category === "technical")
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Technical | Vignesh Venkatesh">
    <main class="category-page" aria-label="Technical posts">
        <HomeScreenBanner title="Technical notes and projects." artworkSrc="/images/banners/technical.webp" monochromeArtwork wideArtwork showLinks={false} />
        <PostList posts={posts} showHeading={false} flushTop />
    </main>
</BaseLayout>
