---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import HomeScreenBanner from "../components/HomeScreenBanner.astro";
import ContentFrame from "../components/ContentFrame.astro";

const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postsByYear = Map.groupBy(posts, (post) => post.data.date.getFullYear());
const postOrder = new Map(posts.map((post, index) => [post.id, index]));

const formatMonth = (date: Date) =>
    date
        .toLocaleDateString("en-US", {
            month: "short",
        })
        .toUpperCase();

const formatDay = (date: Date) => String(date.getDate()).padStart(2, "0");
---

<BaseLayout title="Archive | Vignesh Venkatesh">
    <main class="category-page" aria-label="Archive">
        <HomeScreenBanner title="All my writings." artworkSrc="/images/banners/archive.webp" monochromeArtwork showLinks={false} />
        <ContentFrame edgeToEdge>

        <!-- archive -->
        <div class="space-y-8">
            {[...postsByYear.entries()].map(([year, yearPosts]) => (
                <section>
                    <!-- year heading -->
                    <div class="mb-1 flex items-center justify-between border-b border-border px-4 pb-2 font-mono text-[10px] text-faint sm:px-6 sm:text-[11px]">
                        <span>{year}</span>
                        <span>
                            {String(yearPosts.length)}{" "}
                            {yearPosts.length === 1 ? "entry" : "entries"}
                        </span>
                    </div>

                    <!-- rows -->
                    <div>
                        {yearPosts.map((post, index) => {
                            const href = `/blog/${post.id}`;
                            return (
                                <article class="border-b border-border">
                                    <div class="post-reveal grid grid-cols-[2rem_3.25rem_minmax(0,1fr)] items-baseline gap-x-3 px-4 py-2.5 sm:grid-cols-[2.25rem_3.5rem_minmax(0,1fr)_auto] sm:gap-x-5 sm:px-6" style={`--post-delay: ${120 + Math.min(postOrder.get(post.id) ?? 0, 10) * 110}ms`}>
                                    <!-- index -->
                                    <span class="font-mono text-[9px] text-faint sm:text-[10px] text-end">
                                        {String(yearPosts.length - index)}
                                    </span>

                                    <!-- date -->
                                    <time
                                        datetime={post.data.date.toISOString()}
                                        class="font-mono text-[9px] text-faint sm:text-[10px]"
                                    >
                                        {formatMonth(post.data.date)}{" "}
                                        {formatDay(post.data.date)}
                                    </time>

                                    <!-- title -->
                                    <a
                                        href={href}
                                        class="font-serif text-sm leading-snug text-foreground transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent sm:text-[0.9375rem]"
                                    >
                                        {post.data.title}
                                    </a>

                                    <!-- category -->
                                    <a
                                        href={`/${post.data.category}`}
                                        class:list={[
                                            "col-start-3 mt-1 font-mono text-[9px] transition-colors duration-150 hover:text-accent sm:col-start-auto sm:mt-0 sm:text-[10px]",
                                        ]}
                                    >
                                        {post.data.category}
                                    </a>
                                    </div>
                                </article>
                            );
                        })}
                    </div>
                </section>
            ))}
        </div>
        </ContentFrame>
    </main>
</BaseLayout>
