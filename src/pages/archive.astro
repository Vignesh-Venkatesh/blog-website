---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import HomeScreenBanner from "../components/HomeScreenBanner.astro";
import PostList from "../components/PostList.astro";

const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<BaseLayout title="Archive | Vignesh Venkatesh">
    <main class="category-page" aria-label="Archive">
        <HomeScreenBanner title="All my writings." artworkSrc="/images/banners/archive.webp" monochromeArtwork showLinks={false} />
        <PostList posts={posts} showHeading={false} flushTop compact showCategory />
    </main>
</BaseLayout>
