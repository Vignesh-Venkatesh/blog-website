---
import Layout from "../../layouts/Layout.astro";
import HatchDivider from "../../components/HatchDivider.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { FaArrowLeft, FaArrowRight } from "react-icons/fa";

const formatDate = (date: Date) =>
    new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
    }).format(date);

export async function getStaticPaths() {
    const posts = await getCollection(
        "blog",
        (post: CollectionEntry<"blog">) => !post.data.draft,
    );

    posts.sort(
        (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
            b.data.pubDate.getTime() - a.data.pubDate.getTime(),
    );

    return posts.map((post: CollectionEntry<"blog">, i: number) => ({
        params: { id: post.id },
        props: {
            post,
            prev: posts[i + 1] ?? null,
            next: posts[i - 1] ?? null,
        },
    }));
}

const { post, prev, next } = Astro.props as {
    post: CollectionEntry<"blog">;
    prev: CollectionEntry<"blog"> | null;
    next: CollectionEntry<"blog"> | null;
};

const rendered = await render(post);
---

<Layout title={`${post.data.title} | Vignesh Venkatesh`}>
    <main class="flex-1 flex flex-col">
        <div
            class="fixed bottom-0 left-0 z-[100] h-1 w-full bg-separator/70"
        >
            <div
                id="reading-progress"
                class="h-full bg-green shadow-[0_0_8px_var(--color-green)] transition-[width] duration-100"
                style="width: 0%"
                role="progressbar"
                aria-label="Reading progress"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
            ></div>
        </div>

        <!-- navbar -->
        <div class="sticky top-0 backdrop-blur-md z-50">
            <div class="max-w-3xl mx-auto">
                <Navbar />
            </div>
            <HatchDivider />
        </div>

        <div
            class="max-w-5xl mx-auto flex-1 flex flex-col w-full"
        >
            <div class="grid lg:grid-cols-[minmax(0,3fr)_14rem] lg:gap-10">
                <div
                    class="max-w-3xl border-x border-x-separator/50 flex flex-col w-full"
                >
                    <!-- header -->
                    <div class="px-6 sm:px-8 pt-10 pb-6">
                <!-- all posts button -->
                <a
                    href="/"
                    class="inline-flex items-center gap-2 font-google text-xs text-tertiary hover:text-green transition-colors group"
                >
                    <div
                        class="flex items-center gap-2 group-hover:gap-1 transition-all duration-200"
                    >
                        <FaArrowLeft size={10} />
                        <p>all posts</p>
                    </div>
                </a>

                <!-- tags -->
                <div class="flex flex-wrap gap-2 my-4 items-center">
                    <p class="text-xs text-tertiary font-semibold">tags:</p>
                    {
                        post.data.tags.map((tag: string) => (
                            <a
                                href={`/tags/${tag}`}
                                class="text-xs px-2 py-1 text-button-text rounded bg-button hover:text-green transition-colors duration-200"
                            >
                                <p>#{tag}</p>
                            </a>
                        ))
                    }
                </div>

                <!-- title -->
                <h1
                    class="text-3xl font-bold text-secondary my-4 leading-tight"
                >
                    {post.data.title}
                </h1>

                <!-- pubDate & reading time -->
                <div
                    class="flex items-center gap-3 font-mono text-xs text-tertiary"
                >
                    <span>{formatDate(post.data.pubDate)}</span>
                </div>

                <!-- font toggle -->
                <div class="mt-4 flex items-center gap-2 text-xs text-tertiary">
                    <span>font —</span>
                    <div class="flex border border-separator/50 rounded overflow-hidden">
                        <button
                            id="btn-mono"
                            class="px-3 py-1 transition-colors duration-200 bg-button text-green hover:cursor-pointer"
                        >
                            mono
                        </button>
                        <button
                            id="btn-serif"
                            class="px-3 py-1 transition-colors duration-200 text-tertiary hover:cursor-pointer"
                        >
                            serif
                        </button>
                    </div>
                </div>
                    </div>

                    <HatchDivider />

                    <!-- content -->
                    <div id="post-content" class="px-6 sm:px-8 py-8 prose-styles font-google">
                        <rendered.Content />
                    </div>

                    <!-- prev & next buttons -->
                    {
                        (prev || next) && (
                            <>
                                <HatchDivider />

                                <div class="grid grid-cols-2 divide-x divide-separator/50">
                            <!-- prev post button -->
                            <div>
                                {prev && (
                                    <a
                                        href={`/blog/${prev.id}`}
                                        class="group block px-6 sm:px-8 py-6 hover:opacity-75 transition-opacity duration-200"
                                    >
                                        <div class="text-sm">
                                            <div class="text-tertiary flex items-center gap-2 group-hover:gap-1 group-hover:text-green transition-all duration-200">
                                                <FaArrowLeft size={10} />
                                                <p>previous</p>
                                            </div>
                                            <p class="text-secondary">
                                                {prev.data.title}
                                            </p>
                                        </div>
                                    </a>
                                )}
                            </div>

                            <!-- next post button -->
                            <div>
                                {next && (
                                    <a
                                        href={`/blog/${next.id}`}
                                        class="group block px-6 sm:px-8 py-6 hover:opacity-75 transition-opacity duration-200"
                                    >
                                        <div class="text-sm text-end">
                                            <div class="text-tertiary justify-end flex items-center gap-2 group-hover:gap-1 group-hover:text-green transition-all duration-200">
                                                <p>next</p>
                                                <FaArrowRight size={10} />
                                            </div>
                                            <p class="text-secondary">
                                                {next.data.title}
                                            </p>
                                        </div>
                                    </a>
                                )}
                            </div>
                                </div>
                            </>
                        )
                    }
                    <HatchDivider />
                    <Footer />
                    <HatchDivider />
                </div>

                <aside
                    id="table-of-contents"
                    class="order-last hidden px-4 py-8 lg:order-none lg:block lg:px-0 lg:py-10"
                >
                    <nav class="sticky top-24" aria-label="Table of contents">
                        <p class="mb-3 font-mono text-[10px] uppercase tracking-widest text-tertiary">
                            on this page
                        </p>
                        <ul id="toc-list" class="space-y-1 border-l border-separator/70"></ul>
                    </nav>
                </aside>
            </div>
        </div>
    </main>
</Layout>


<script>
    const btnMono = document.getElementById("btn-mono");
    const btnSerif = document.getElementById("btn-serif");
    const content = document.getElementById("post-content");
    const progress = document.getElementById("reading-progress");
    const tableOfContents = document.getElementById("table-of-contents");
    const tocList = document.getElementById("toc-list");

    const headings = Array.from(content?.querySelectorAll("h2, h3") ?? []);

    headings.forEach((heading, index) => {
        if (!heading.id) {
            heading.id = `${heading.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "") || "section"}-${index}`;
        }

        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent?.trim() || "section";
        link.className = "block border-l-2 border-transparent px-3 py-1 text-xs leading-relaxed text-tertiary transition-colors hover:border-green/50 hover:text-green";

        if (heading.tagName === "H3") {
            link.classList.add("pl-5", "text-[11px]");
        }

        const item = document.createElement("li");
        item.append(link);
        tocList?.append(item);
    });

    if (headings.length === 0 && tableOfContents) {
        tableOfContents.remove();
    }

    const tocLinks = Array.from(tocList?.querySelectorAll("a") ?? []);
    const setActiveHeading = (id: string) => {
        tocLinks.forEach((link) => {
            const active = link.getAttribute("href") === `#${id}`;
            link.classList.toggle("border-green", active);
            link.classList.toggle("text-green", active);
            link.classList.toggle("text-tertiary", !active);
            if (active) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
        });
    };

    if (headings.length > 0) {
        setActiveHeading(headings[0].id);
        const headingObserver = new IntersectionObserver(
            (entries) => {
                const visibleHeading = entries
                    .filter((entry) => entry.isIntersecting)
                    .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

                if (visibleHeading) setActiveHeading(visibleHeading.target.id);
            },
            { rootMargin: "-15% 0px -70% 0px" },
        );

        headings.forEach((heading) => headingObserver.observe(heading));
    }

    const updateReadingProgress = () => {
        if (!progress) return;

        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        const percentage = scrollableHeight > 0
            ? Math.min(100, Math.max(0, (window.scrollY / scrollableHeight) * 100))
            : 100;

        progress.style.width = `${percentage}%`;
        progress.setAttribute("aria-valuenow", String(Math.round(percentage)));
    };

    window.addEventListener("scroll", updateReadingProgress, { passive: true });
    window.addEventListener("resize", updateReadingProgress);
    updateReadingProgress();

    btnMono?.addEventListener("click", () => {
        content?.classList.remove("font-ibm");
        content?.classList.add("font-google");
        btnMono.classList.add("bg-button", "text-green");
        btnMono.classList.remove("text-tertiary");
        btnSerif?.classList.remove("bg-button", "text-primary");
        btnSerif?.classList.add("text-tertiary");
    });

    btnSerif?.addEventListener("click", () => {
        content?.classList.remove("font-google");
        content?.classList.add("font-ibm");
        btnSerif.classList.add("bg-button", "text-green");
        btnSerif.classList.remove("text-tertiary");
        btnMono?.classList.remove("bg-button", "text-primary");
        btnMono?.classList.add("text-tertiary");
    });
</script>
