---
import { ArrowUp } from "@lucide/astro";

const links = [
    { label: "GitHub", url: "https://github.com/Vignesh-Venkatesh" },
    { label: "Portfolio", url: "https://vigneshvenkatesh.com" },
    { label: "LinkedIn", url: "https://linkedin.com/in/vignesh-2k3" },
];
---

<footer class="site-footer">
    <div class="footer-inner">
        <p class="credit">made with 💚 by vignesh</p>
        <div class="footer-links">
            <nav aria-label="Footer navigation">
                {links.map(({ label, url }) => (
                    <a href={url} target="_blank" rel="noopener noreferrer">{label}</a>
                ))}
            </nav>
            <a class="back-to-top" href="#top">
                back to top
                <ArrowUp size={13} strokeWidth={1.5} aria-hidden="true" />
            </a>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border-top: 1px solid var(--color-border);
        padding: 2.5rem 0 3rem;
        background:
            radial-gradient(ellipse at 0 100%, rgb(21 56 43 / 20%), transparent 45%),
            radial-gradient(ellipse at 100% 100%, rgb(21 56 43 / 27%), transparent 45%),
            var(--color-background);
    }

    .site-footer::before {
        position: absolute;
        z-index: -1;
        inset: 0;
        content: "";
        pointer-events: none;
        background-image: radial-gradient(circle, var(--color-accent) 0.7px, transparent 0.9px);
        background-size: 4px 4px;
        opacity: 0.04;
        mask-image: linear-gradient(90deg, #000, transparent 30%, transparent 70%, #000);
    }

    .footer-inner {
        display: flex;
        width: min(100%, 44rem);
        margin-inline: auto;
        padding-inline: 1.25rem;
        flex-direction: column;
        gap: 1.75rem;
    }

    .credit {
        margin: 0;
        color: var(--color-muted);
        font: 400 0.8125rem/1.5 var(--font-google);
    }

    .footer-links {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.25rem;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.25rem;
    }

    a {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 0.25rem;
        color: var(--color-muted);
        font: 400 0.8125rem/1.5 var(--font-google);
        text-decoration: none;
        transition: color 160ms ease;
    }

    a:hover,
    a:focus-visible {
        color: var(--color-accent);
        font-weight: 600;
    }

    @media (min-width: 40rem) {
        .site-footer { padding-block: 3rem; }
        .footer-inner {
            padding-inline: 1.5rem;
            flex-direction: row;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1.75rem;
        }
        .footer-links { align-items: flex-end; gap: 1.25rem; }
    }
</style>
