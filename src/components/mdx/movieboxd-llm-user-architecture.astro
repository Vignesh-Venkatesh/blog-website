---
import architecture from "../../assets/movieboxd-architecture.svg?url";
---

<div class="my-4">
    <div class="overflow-x-auto rounded bg-card/30 p-2">
        <img src={architecture} alt="MovieBoxd fake user architecture" class="mx-auto w-full min-w-[620px]" />
    </div>

    <div class="flex justify-end mt-2">
        <span class="text-xs italic text-tertiary/50">
            Inspired by
            <a
                href="https://support.claude.com/en/articles/9487310-what-are-artifacts-and-how-do-i-use-them"
                target="_blank"
            >
                Claude's Artifacts
            </a>
        </span>
    </div>
</div>
