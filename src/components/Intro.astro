<section class="relative min-h-72 overflow-hidden sm:min-h-0">
    <!-- god's hand artwork -->
    <img
        src="/images/site/creation.svg"
        alt=""
        aria-hidden="true"
        class="home-cover article-cover pointer-events-none absolute inset-0 h-full w-full scale-[1.3] object-cover object-center select-none sm:scale-100"
        loading="eager"
        fetchpriority="high"
    />

    <!-- fading both edges -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-bg)_0%,transparent_28%,transparent_72%,var(--color-bg)_100%)]"
    ></div>

    <div class="relative z-10 mx-auto flex min-h-72 max-w-175 items-center px-6 sm:min-h-0 sm:py-20">
        <div class="max-w-xl">
            <h1 class="page-reveal page-delay-1 font-serif text-[2.2rem] leading-[1.08] tracking-tight text-foreground">
                Welcome to my blog.
            </h1>

            <div class="page-reveal page-delay-2 mt-6 flex gap-5 font-mono text-[12px] text-muted font-semibold">
                <a href="/technical" class="hover:text-accent">
                    technical
                </a>

                <a href="/notebook" class="hover:text-accent">
                    notebook
                </a>

                <a href="/archive" class="hover:text-accent">
                    archive
                </a>
            </div>
        </div>
    </div>
</section>

<script>
    const cover = document.querySelector<HTMLImageElement>(".home-cover");

    if (cover) {
        const reveal = async () => {
            try {
                await cover.decode();
            } catch {
                // the image may already be decoded or decoding may be unsupported
            }

            cover.classList.add("article-cover-loaded");
        };

        if (cover.complete && cover.naturalWidth > 0) {
            void reveal();
        } else {
            cover.addEventListener(
                "load",
                () => {
                    void reveal();
                },
                { once: true },
            );
        }
    }
</script>
