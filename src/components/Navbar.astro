---
const path = Astro.url.pathname;
const links = [
    { href: "/technical", label: "technical" },
    { href: "/notebook", label: "notebook" },
    { href: "/index", label: "index" },
];
---

<header>
    <div class="mx-auto flex h-16 max-w-175 items-center justify-between gap-3 px-6">
        <a
            href="/"
            class="site-name shrink-0 font-serif text-lg font-semibold tracking-wide focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent focus-visible:ring-offset-4 focus-visible:ring-offset-bg"
        >
            vigiii
            <span class="brand-mark text-accent" aria-hidden="true">
                .
            </span>
        </a>
        <nav
            aria-label="Primary navigation"
            class="flex items-center gap-3 font-mono text-[10px] text-muted min-[380px]:gap-4 sm:gap-5 sm:text-xs"
        >
            {links.map((link) => (
                <a
                    href={link.href}
                    aria-current={
                        path === link.href || path.startsWith(`${link.href}/`)
                            ? "page"
                            : undefined
                    }
                    class:list={[
                        "nav-link whitespace-nowrap transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent focus-visible:ring-offset-4 focus-visible:ring-offset-bg",
                        (path === link.href ||
                            path.startsWith(`${link.href}/`)) &&
                            "text-foreground",
                    ]}
                >
                    {link.label}
                </a>
            ))}
        </nav>
    </div>
</header>
