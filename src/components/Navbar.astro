---
const links = [
    { label: "technical", href: "/technical" },
    { label: "notebook", href: "/notebook" },
    { label: "archive", href: "/archive" },
    { label: "tags", href: "/tags" },
];
---

<header class="site-header" transition:persist="site-navbar" transition:animate="none">
    <nav class="navbar" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="vigi home">
            <img class="brand-mark" src="https://avatars.githubusercontent.com/u/78854880" alt="" />
            <span class="brand-name">vigi.</span>
        </a>
        <div class="nav-links">
            {links.map(({ label, href }) => <a href={href}>{label}</a>)}
        </div>
    </nav>
</header>

<style>
    .site-header {
        position: relative;
        z-index: 2;
        background-color: var(--color-background);
        color: var(--color-foreground);
        border-bottom: 1px solid var(--color-border);
    }

    .navbar {
        width: min(100% - 3rem, 43.75rem);
        min-height: 4.5rem;
        margin-inline: auto;
        padding: 0.75rem clamp(1rem, 3vw, 1.5rem);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        color: #ededed;
        text-decoration: none;
    }

    .brand-mark {
        display: block;
        width: 2.8rem;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 50%;
    }

    .brand-name {
        font: 600 1rem var(--font-google);
        letter-spacing: normal;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.35rem;
    }

    .nav-links a {
        color: var(--color-muted);
        font: 400 0.7rem / 1 var(--font-google);
        letter-spacing: normal;
        text-decoration: none;
        transition: color 160ms ease;
    }

    .nav-links a:hover,
    .nav-links a:focus-visible {
        color: var(--color-accent);
        font-weight: 600;
    }

    @media (max-width: 540px) {
        .navbar {
            min-height: 4rem;
            gap: 0.75rem;
        }

        .brand-mark {
            width: 2.35rem;
        }

        .nav-links {
            gap: 0.75rem;
        }

    }
</style>
