---
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    date: string;
    newer?: CollectionEntry<"blog">;
    older?: CollectionEntry<"blog">;
}

const { date, newer, older } = Astro.props;
---

<footer class="mt-16 border-t border-border pt-5">
    <div class="flex flex-col gap-4 font-mono text-[10px] text-faint sm:flex-row sm:items-center sm:justify-between sm:text-[11px]">
        <a
            href="/archive"
            class="article-end-link text-muted transition-colors hover:text-accent"
        >
            <ArrowLeft size={13} strokeWidth={1.5} class="inline-block align-middle" aria-hidden="true" /> all posts
        </a>
        <p>written {date}</p>
    </div>

    {(older || newer) && (
        <nav
            aria-label="Article navigation"
            class="mt-10 grid gap-6 border-t border-border pt-6 sm:grid-cols-2"
        >
            <div>
                {older && (
                    <a
                        href={`/blog/${older.id}`}
                        class="article-end-link post-nav-link"
                    >
                        <span class="post-nav-label">
                            <ArrowLeft size={12} strokeWidth={1.5} aria-hidden="true" /> previous
                        </span>

                        <span class="post-nav-title">
                            {older.data.title}
                        </span>
                    </a>
                )}
            </div>

            <div class="post-nav-next sm:text-right">
                {newer && (
                    <a
                        href={`/blog/${newer.id}`}
                        class="article-end-link post-nav-link"
                    >
                        <span class="post-nav-label">
                            next <ArrowRight size={12} strokeWidth={1.5} aria-hidden="true" />
                        </span>

                        <span class="post-nav-title">
                            {newer.data.title}
                        </span>
                    </a>
                )}
            </div>
        </nav>
    )}
</footer>

<style>
    .post-nav-link {
        display: grid;
        gap: 0.5rem;
        color: var(--color-muted);
        font: 600 0.875rem / 1.6 var(--font-google);
        transition: color 160ms ease;
    }

    .post-nav-label {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.625rem;
        line-height: 1.5;
        text-transform: uppercase;
    }

    .post-nav-title {
        overflow-wrap: anywhere;
    }

    .post-nav-link:hover,
    .post-nav-link:focus-visible {
        color: var(--color-accent);
        font-weight: 600;
    }

    @media (min-width: 40rem) {
        .post-nav-link { justify-items: start; }
        .post-nav-next .post-nav-link { justify-items: end; }
    }
</style>
