---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";
import Divider from "./Divider.astro";

interface Props {
    posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const formatDate = (date: Date) =>
    date
        .toLocaleDateString("en-US", {
            month: "short",
            day: "2-digit",
            year: "numeric",
        })
        .toUpperCase();
---

<section class="mx-auto max-w-175 px-6 py-14 sm:py-20">
    <div class="page-reveal page-delay-4 mb-8 flex items-center gap-2 font-mono text-[10px] tracking-[0.12em] text-faint sm:text-[11px]">
        <span>total_posts</span>
        <span>=</span>
        <span>{posts.length}</span>
    </div>

    <div class="page-reveal page-delay-5">
        <Divider />
    </div>

    <div class="page-reveal page-delay-6">
        {posts.map((post, index) => {
            const href = `/blog/${post.id}`;

            return (
                <article class="relative border-b border-border py-9 sm:py-10">
                    <div>
                        <div class="mb-3 flex flex-wrap items-center gap-2 font-mono text-[10px] sm:text-[11px]">
                            <!-- <span class="mr-1 text-faint">
                                {String(index + 1).padStart(2, "0")}
                            </span> -->

                            <a
                                href={`/${post.data.category}`}
                                class:list={[
                                    "transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent",
                                    post.data.category === "technical"
                                        ? "text-accent"
                                        : "text-muted",
                                ]}
                            >
                                {post.data.category}
                            </a>

                            <span class="text-faint">·</span>

                            <time
                                datetime={post.data.date.toISOString()}
                                class="text-faint"
                            >
                                {formatDate(post.data.date)}
                            </time>
                        </div>

                        <h2 class="font-serif text-2xl font-medium leading-tight tracking-tight sm:text-[1.65rem]">
                            <a
                                href={href}
                                class="text-foreground transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent"
                            >
                                {post.data.title}
                            </a>
                        </h2>

                        <p
                            class:list={[
                                "mt-3 max-w-2xl font-serif text-base leading-relaxed text-muted sm:text-[1.05rem]",
                                post.data.category === "notebook" && "italic",
                            ]}
                        >
                            {post.data.description}
                        </p>

                        <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
                            <TagList tags={post.data.tags} />

                            <a
                                href={href}
                                class="font-mono text-[10px] text-faint transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent sm:text-[11px]"
                            >
                                read →
                            </a>
                        </div>
                    </div>
                </article>
            );
        })}
    </div>
</section>
