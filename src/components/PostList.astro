---
import { ArrowRight } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import readingTime from "reading-time";
import TagList from "./TagList.astro";
import Divider from "./Divider.astro";

interface Props {
    posts: CollectionEntry<"blog">[];
    showHeading?: boolean;
    flushTop?: boolean;
    compact?: boolean;
    showCategory?: boolean;
    heading?: string;
    showCount?: boolean;
    headingDivider?: boolean;
}
const { posts, showHeading = true, flushTop = false, compact = false, showCategory = false, heading = "latest writing", showCount = true, headingDivider = false } = Astro.props;
const postsByYear = Map.groupBy(posts, (post) => post.data.date.getUTCFullYear());
const formatDate = (date: Date) => date.toLocaleDateString("en-US", {
    month: "short", day: "2-digit", year: "numeric", timeZone: "UTC",
});
---

<section class:list={["post-list", { "flush-top": flushTop, compact }]} aria-label={showHeading ? heading : "Blog posts"}>
    {showHeading && <Divider contained markersOnly={!headingDivider} />}
    {showHeading && <div class="list-heading">
        <span>{heading}</span>
        {showCount && <span>{posts.length} {posts.length === 1 ? "post" : "posts"}</span>}
    </div>}
    <Divider contained markersOnly={flushTop && !showHeading} />
    {posts.map((post, index) => {
        const href = `/blog/${post.id}`;
        const year = post.data.date.getUTCFullYear();
        const startsYear = compact && (index === 0 || posts[index - 1].data.date.getUTCFullYear() !== year);
        const yearCount = postsByYear.get(year)?.length ?? 0;
        return (
            <>
            {startsYear && <div class="year-heading">
                <h2>{year}</h2>
                <span>{yearCount} {yearCount === 1 ? "post" : "posts"}</span>
            </div>}
            <article>
                <div class="post-content">
                    <div class="post-reveal" style={`--post-delay: ${120 + Math.min(index, 10) * 110}ms`}>
                    {compact ? <div class:list={["compact-row", { "with-category": showCategory }]}>
                        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                        <h2><a href={href}>{post.data.title}</a></h2>
                        {showCategory && <a class="compact-category" href={`/${post.data.category}`}>{post.data.category}</a>}
                        <div class="compact-bottom">
                            <TagList tags={post.data.tags} />
                            <div class="compact-actions">
                            <a class="read-link" href={href} aria-label={`Read ${post.data.title}`}>read post <ArrowRight size={14} strokeWidth={1.5} aria-hidden="true" /></a>
                            </div>
                        </div>
                    </div> : <>
                    <div class="post-meta">
                        <a class:list={["category", { "category-notebook": post.data.category === "notebook" }]} href={`/${post.data.category}`}>{post.data.category}</a>
                        <span aria-hidden="true">·</span>
                        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                        <span aria-hidden="true">·</span>
                        <span>{readingTime(post.body ?? "").text}</span>
                    </div>
                    <h2><a href={href}>{post.data.title}</a></h2>
                    <p class="description">{post.data.description}</p>
                    <div class="post-bottom">
                        <TagList tags={post.data.tags} />
                        <a class="read-link" href={href} aria-label={`Read ${post.data.title}`}>read post <ArrowRight size={14} strokeWidth={1.5} aria-hidden="true" /></a>
                    </div>
                    </>}
                    </div>
                </div>
                <Divider contained />
            </article>
            </>
        );
    })}
    {flushTop && posts.length > 0 && <>
        <div class="post-list-tail" aria-hidden="true"></div>
        <Divider contained markersOnly />
    </>}
    {posts.length === 0 && <p class="empty-state">No posts published yet.</p>}
</section>

<style>
    .post-list {
        --grid-line: color-mix(in oklab, var(--color-foreground) 28%, var(--color-background));
        padding-top: 0;
    }

    .post-list.flush-top {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding-top: 0;
    }

    .post-list-tail {
        flex: 1;
        width: min(100% - 3rem, 43.75rem);
        margin-inline: auto;
        border-inline: 1px solid var(--grid-line);
    }

    .list-heading,
    .post-content,
    .empty-state {
        width: min(100% - 3rem, 43.75rem);
        margin-inline: auto;
    }

    .list-heading {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.25rem clamp(1rem, 3vw, 1.5rem);
        border-inline: 1px solid var(--grid-line);
        color: var(--color-muted);
        font: 400 0.75rem/1.5 var(--font-google);
    }

    .post-content {
        padding-block: 1.5rem;
        padding-inline: clamp(1rem, 3vw, 1.5rem);
        border-inline: 1px solid var(--grid-line);
    }

    .post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-muted);
        font: 400 0.7rem/1.6 var(--font-google);
    }

    .category { color: var(--color-accent); }
    .category-notebook { color: var(--color-foreground); }

    .compact .post-content {
        padding-block: 0.625rem;
    }

    .compact-row {
        display: grid;
        grid-template-columns: 6.5rem minmax(0, 1fr);
        align-items: baseline;
        gap: 0.75rem;
    }

    .compact-row time {
        color: var(--color-faint);
        font: 400 0.625rem/1.6 var(--font-mono);
    }

    .compact-row h2 {
        margin: 0;
        font: 400 0.9375rem/1.4 var(--font-serif);
    }

    .compact-bottom {
        grid-column: 2;
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .compact-category {
        color: var(--color-muted);
        grid-column: 3;
        grid-row: 1;
        justify-self: end;
        font: 400 0.6875rem/1.5 var(--font-mono);
    }

    .compact-row.with-category {
        grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    }

    .with-category .compact-bottom {
        grid-column: 2 / -1;
    }

    .compact-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.25rem;
        margin-left: auto;
    }

    .year-heading {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        width: min(100% - 3rem, 43.75rem);
        margin-inline: auto;
        padding: 1.5rem clamp(1rem, 3vw, 1.5rem) 0.5rem;
        border-inline: 1px solid var(--grid-line);
        border-bottom: 1px solid var(--color-border);
        color: var(--color-faint);
        font: 400 0.6875rem/1.5 var(--font-mono);
    }

    .year-heading h2 {
        margin: 0;
        color: inherit;
        font: inherit;
    }

    @media (max-width: 639px) {
        .compact-row {
            grid-template-columns: 5.75rem minmax(0, 1fr);
        }

        .compact-row.with-category {
            grid-template-columns: 5.75rem minmax(0, 1fr) auto;
        }

        .compact-row time { font-size: 0.5625rem; }
        .compact-row h2 { font-size: 0.875rem; }
    }

    h2 {
        max-width: 52rem;
        margin: 0.85rem 0 0.65rem;
        color: var(--color-foreground);
        font: 500 clamp(1.125rem, 2.5vw, 1.5rem)/1.4 var(--font-google);
        overflow-wrap: anywhere;
    }

    .description {
        max-width: 44rem;
        margin: 0;
        color: var(--color-muted);
        font: 400 0.9375rem/1.7 var(--font-geist);
    }

    .post-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .read-link {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--color-muted);
        font: 400 0.75rem/1.5 var(--font-google);
    }

    a { text-decoration: none; transition: color 160ms ease; }
    a:hover, a:focus-visible { color: var(--color-accent); font-weight: 600; }
    .empty-state { padding-block: 2rem; color: var(--color-muted); }
</style>
