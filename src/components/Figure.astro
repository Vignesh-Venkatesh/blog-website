---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    alt: string;
    caption?: string;
    credit?: string;
}

const { src, alt, caption, credit } = Astro.props;
---

<figure class="photo-figure">
    <Image
        src={src}
        alt={alt}
        widths={[640, 900, 1200]}
        sizes="(max-width: 948px) calc(100vw - 3rem), 900px"
        loading="lazy"
        decoding="async"
    />

    {(caption || credit) && (
        <figcaption>
            {caption && <span>{caption}</span>}
            {credit && <span class="figure-credit">{credit}</span>}
        </figcaption>
    )}
</figure>
